# B02/B03 simulated workbench. Copy to .env and customise locally.
TRIPMATE_EXECUTION_MODE=FIXTURE
TRIPMATE_DATABASE_PATH=./data/tripmate.sqlite3
TRIPMATE_CURRENCY=AUD
# Shared campus model adapter is installed; set a personal key only in local .env.
TRIPMATE_LLM_PROVIDER=elec5620
TRIPMATE_LLM_MODEL=campus-qwen
ELEC5620_API_KEY=REPLACE_LOCALLY
ELEC5620_BASE_URL=http://10.167.60.148:8000/v1
ELEC5620_MODEL=campus-qwen
# Planning demonstration, if present, uses a separate *.planning-demo.sqlite3
# database automatically. B03 reset NEVER deletes shared Planning data.

# Authenticated portals use Supabase Auth + private cloud Operations storage.
# Obtain keys for THIS project only. Never commit the server secret.
SUPABASE_URL=https://bkfqklqxjcjbcstpyqxo.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET_KEY
# Omit for local loopback. Set the exact HTTPS origin when deploying behind TLS.
# TRIPMATE_PUBLIC_ORIGIN=https://your-tripmate-domain.example

# Set an explicitly approved Supplier pricing policy after merging B04.
# Examples only; these are not inferred global commercial defaults.
# TRIPMATE_MARKUP_RATE=0.10
# TRIPMATE_MINIMUM_MARGIN=15.00
# TRIPMATE_PRICING_CONFIG_VERSION=operator-policy-1
