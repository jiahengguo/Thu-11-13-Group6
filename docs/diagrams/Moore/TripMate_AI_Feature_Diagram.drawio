        <mxCell id="FRESH" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontStyle=0;strokeColor=#334155;fillColor=#ffffff;spacing=8;" value="Evidence freshness&#xa;and uncertainty disclosure" vertex="1">
