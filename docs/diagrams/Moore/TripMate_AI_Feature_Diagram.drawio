        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontStyle=0;strokeColor=#334155;fillColor=#ffffff;spacing=8;strokeColor=none;fillColor=none;align=left;" value="NOTATION&#xa;● Mandatory: child required if parent selected. ○ Optional: child may be selected.&#xa;Empty group arc = XOR, exactly one. Filled group arc = OR, at least one. Group-member edges have no individual mandatory circles.&#xa;Dashed requires / excludes connectors are on page 2; endpoints reference the SAME Feature IDs as this tree." vertex="1">
          <mxGeometry height="115" width="2440" x="30" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="rules" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontStyle=0;strokeColor=#334155;fillColor=#ffffff;spacing=8;strokeColor=none;fillColor=none;align=left;" value="MODEL RULES&#xa;C1 PAID excludes ADS. C2 ADS requires FREE. C3 RULE requires ELIG. C4 DISCOUNT requires RULE. C5 DISCOUNT requires ELIG. C6 DISCOUNT requires PRICE.&#xa;C7 SUP-03 requires APPROVAL. C8 TP-O2 requires FRESH. C9 TP-O2 requires SECURITY. C10 TP-O3 requires CONSENT. C11 TP-O4 requires FRESH.&#xa;C1–C2 apply to the same traveller context; C4–C6 to the same quotation. These are selection constraints, not activity-flow arrows." vertex="1">
          <mxGeometry height="115" width="2440" x="30" y="1535" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontStyle=0;strokeColor=#334155;fillColor=#ffffff;spacing=8;strokeColor=none;fillColor=none;align=left;" value="SCOPE AND TRACEABILITY&#xa;Seven mandatory domains express required product capabilities, not mandatory execution in every request. Feature presence does not cause an approval, advertisement or discount to execute.&#xa;Runtime ADVERTISING and DISCOUNT selections are contextual; the product retains the capability. Core quality / oversight controls remain mandatory.&#xa;The optional EXT parent plus its OR group permits 0–4 planning extensions without making any optional requirement mandatory. Simulated updates suffice for EXC-O1.&#xa;Sources: TripMate AI.md §§2–4; Supplier_Requirements.md; Stage1_Modeling_Task_List.md §8. Notation: ELEC5620-TUT-03, pp.12–14. TP-* follows detailed requirements." vertex="1">
          <mxGeometry height="140" width="2440" x="30" y="1670" as="geometry" />
        </mxCell>
